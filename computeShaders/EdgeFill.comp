#version 450

layout (local_size_x = 16, local_size_y = 16) in;
layout(binding = 0, rgba8) uniform readonly image2D image;
layout(binding = 1, rgba8) uniform image2D resultImage;

void main(){
	// Sets the value of a (0,0,0) pixel to either the nearest value or the average of near values if there are multiple equidistant values
	int kernsize = 10;
	ivec2 pixelCoords = ivec2(gl_GlobalInvocationID.xy);
	vec4 imagePix = imageLoad(image, pixelCoords);

	vec4 nearestPixel = vec4(0,0,0,0);

	if (imagePix.w < 1.0f){ // Assume that anything drawn to the image uses an opaque material
		float minDistance = (kernsize+1)*(kernsize+1);

		for (int x = -kernsize; x != kernsize; x++){
			for (int y = -kernsize; y != kernsize; y++){
				float distance = length(vec2(x, y));
				if (distance <= minDistance){
					vec4 readPix = imageLoad(image, ivec2(pixelCoords.x+x, pixelCoords.y+y));
					if (readPix.w == 1.0f){
						nearestPixel = (distance<minDistance)?vec4(0,0,0,0):nearestPixel;
						nearestPixel += vec4(readPix.rgb, 1.0);
						minDistance = distance;
					}
				}
			}
		}
		if (nearestPixel.w == 0.0f){
			nearestPixel = vec4(imagePix.rgb, 1.0); // If no close pixels are found then just set the alpha to 1
		}
	} else {
		nearestPixel = vec4(imagePix.rgb, 1.0);
	}

	vec4 pixel = vec4((nearestPixel.rgb/nearestPixel.w), 1.0);

	imageStore(resultImage, pixelCoords, pixel);
}