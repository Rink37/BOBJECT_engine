#version 450

layout (local_size_x = 16, local_size_y = 16) in;
layout(binding = 0, rgba8) uniform image2D baseImage;
layout(binding = 1, rgba8) uniform image2D alphaImage;

void main(){
	ivec2 pixelCoords = ivec2(gl_GlobalInvocationID.xy);

	vec4 pixel = imageLoad(baseImage, pixelCoords);
	vec4 alpha = vec4(vec3(pixel.w), 1.0f);
	pixel.w = 1.0f;

	imageStore(baseImage, pixelCoords, pixel);
	imageStore(alphaImage, pixelCoords, alpha);
}