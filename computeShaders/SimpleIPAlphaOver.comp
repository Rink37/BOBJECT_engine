#version 450

layout (local_size_x = 16, local_size_y = 16) in;
layout(binding = 0, rgba8) uniform image2D baseImage;
layout(binding = 1, rgba8) uniform readonly image2D overlayImage;

void main(){
	ivec2 pixelCoords = ivec2(gl_GlobalInvocationID.xy);

	vec4 pixel = imageLoad(baseImage, pixelCoords);
	vec4 overlayPix = imageLoad(overlayImage, pixelCoords);

	pixel.rgb = pixel.rgb * (1.0 - overlayPix.w) + overlayPix.rgb * overlayPix.w;

	imageStore(baseImage, pixelCoords, pixel);
}